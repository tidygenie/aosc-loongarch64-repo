 	crtc_array_mode = LOONGGPU_TILING_GET(abo->tiling_flags, ARRAY_MODE);
 
+	/* GBM uses private tiling even when KMS modifiers are unavailable.
+	 * Keep the DC tiling mode in sync with the BO being scanned out. */
+	if (dc_crtc->array_mode != crtc_array_mode) {
+		timing = *dc_crtc->timing;
+		timing.stride = fb->pitches[0];
+		dc_crtc->array_mode = crtc_array_mode;
+		dc_submit_timing_update(dc, acrtc->crtc_id, &timing);
+	}
+
 	if (crtc_array_mode == 0 && crtc->x) {
 		if (!(fb->width % 64))
 			align = 64;
@@ -1593,6 +1605,7 @@
 
 		plane->primary.address.low_part = lower_32_bits(disp_bo->gpu_addr);
 		plane->primary.address.high_part = upper_32_bits(disp_bo->gpu_addr);
