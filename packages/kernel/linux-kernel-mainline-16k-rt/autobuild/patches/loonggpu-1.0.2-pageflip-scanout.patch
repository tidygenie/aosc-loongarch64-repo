diff -ruN a/loonggpu/loonggpu_dc_crtc.c b/loonggpu/loonggpu_dc_crtc.c
--- a/loonggpu/loonggpu_dc_crtc.c
+++ b/loonggpu/loonggpu_dc_crtc.c
@@ -581,9 +581,25 @@
 bool crtc_primary_plane_set(struct loonggpu_dc_crtc *crtc,
 					 struct dc_primary_plane *primary)
 {
+	struct loonggpu_device *adev;
+	u32 link, stride;
+
 	if (IS_ERR_OR_NULL(crtc) || IS_ERR_OR_NULL(primary))
 		return false;
 
+	/* The address and pitch must always describe the same scanout BO. */
+	if (primary->stride) {
+		adev = crtc->dc->adev;
+		link = crtc->resource->base.link;
+		stride = primary->stride;
+		if (crtc->array_mode == 2)
+			stride *= 4;
+
+		if (dc_readl(adev, gdc_reg->crtc_reg[link].stride) != stride)
+			dc_writel(adev, gdc_reg->crtc_reg[link].stride, stride);
+		crtc->timing->stride = primary->stride;
+	}
+
 	return dc_crtc_fb_address_update(crtc, primary->address);
 }
 
@@ -859,6 +875,7 @@
 	plane.type = DC_PLANE_PRIMARY;
 	plane.primary.address.low_part = lower_32_bits(disp_bo->gpu_addr);
 	plane.primary.address.high_part = upper_32_bits(disp_bo->gpu_addr);
+	plane.primary.stride = disp_bo->pitch;
 
 	dc_submit_plane_update(adev->dc, lcrtc->crtc_id, &plane);
 
