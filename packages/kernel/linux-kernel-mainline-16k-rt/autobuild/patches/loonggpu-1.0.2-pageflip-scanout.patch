 		spin_lock_irqsave(&crtc->dev->event_lock, flags);
 		acrtc->pflip_copy = LOONGGPU_FLIP_COPY_DONE;
@@ -1828,6 +1841,7 @@
 
 			plane->primary.address.low_part = lower_32_bits(disp_bo->gpu_addr);
