#!/usr/bin/env bash
# vkgl: Vulkan 1.0 subset implemented on top of the vendor gsgpu GL 2.1 stack.
set -euo pipefail
FILES="$(cd "$(dirname "${BASH_SOURCE[0]}")/../files" && pwd)"

SPIRV_CROSS_DIR="${SPIRV_CROSS_DIR:-/usr}" \
  bash "$FILES/build-vkgl.sh" /tmp/libvkgl.so

install -Dvm755 /tmp/libvkgl.so "$PKGDIR/usr/lib/vkgl/libvkgl.so"
install -Dvm644 "$FILES/vkgl_icd.json" "$PKGDIR/usr/share/vulkan/icd.d/vkgl_loonggpu.json"
install -Dvm644 "$FILES"/README* "$PKGDIR/usr/share/doc/vkgl-loonggpu/README" 2>/dev/null || true
install -Dvm755 "$(dirname "${BASH_SOURCE[0]}")/postinst" "$PKGDIR/DEBIAN/postinst"
