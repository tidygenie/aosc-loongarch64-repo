VER=%PKGVER%
unset ARCH
set -e

echo "Installing LoongGPU kernel modules..."
failed=""
for i in `ls /usr/lib/modules | grep -v 'extramodules'`; do
	if [ -f "/usr/lib/modules/${i}/modules.dep" -a \
	     -f "/usr/lib/modules/${i}/modules.order" -a \
	     -f "/usr/lib/modules/${i}/modules.builtin" ]; then
		objtool="/usr/lib/modules/${i}/build/tools/objtool/objtool"
		if [ -x "$objtool" ] && ldd "$objtool" 2>/dev/null | grep -q 'not found'; then
			echo -e "\033[33m**\033[0m\tSkipping $i: headers objtool has unresolved libraries ..."
			continue
		fi
		echo -e "\033[36m**\033[0m\tBuilding LoongGPU kernel modules for $i ..."
		if ! dkms install loonggpu/${VER} -k $i; then
			failed="$failed $i"
		fi
	else
		echo -e "\033[33m**\033[0m\tSkipping incomplete kernel modules tree $i ..."
	fi
done

update-initramfs
if [ -n "$failed" ]; then
	echo "LoongGPU DKMS build failed for:$failed" >&2
	exit 1
fi
